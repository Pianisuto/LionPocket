FROM node:24-bookworm AS node
FROM ubuntu:24.04
COPY --from=node /usr/local/ /usr/local/
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libgtk-3-0t64 libgbm1 libnss3 libxss1 libasound2t64 libsecret-1-0 \
    dbus-x11 libglib2.0-bin desktop-file-utils xdg-utils xvfb xauth sudo ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
ENV CI=true
ENV LIONPOCKET_DISPOSABLE_CONTAINER=1
