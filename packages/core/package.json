{
  "name": "@lionpocket/core",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./finance": {
      "types": "./dist/finance.d.ts",
      "default": "./dist/finance.js"
    },
    "./credit-cards": {
      "types": "./dist/credit-cards.d.ts",
      "default": "./dist/credit-cards.js"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "default": "./dist/transactions.js"
    },
    "./planning": {
      "types": "./dist/planning.d.ts",
      "default": "./dist/planning.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --ext .ts src"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "fast-xml-parser": "^5.10.1"
  }
}
