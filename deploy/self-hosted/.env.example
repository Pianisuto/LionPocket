# Replace these example hosts. No scheme, path or port.
SYNC_HOST=sync.example.com
AUTH_HOST=auth.example.com
# Unique on this Docker host; keep stable across upgrades.
COMPOSE_PROJECT_NAME=lionpocket-sync
# caddy obtains public HTTPS on ports 80/443; existing uses your own proxy.
REVERSE_PROXY=caddy
# Persist outside the checkout, so replacing code cannot delete credentials.
# lpctl expands ~ and passes absolute paths to Compose; init creates missing files only.
POSTGRES_PASSWORD_FILE=~/.local/share/lionpocket-sync/secrets/postgres
SYNC_DB_PASSWORD_FILE=~/.local/share/lionpocket-sync/secrets/sync
AUTH_DB_PASSWORD_FILE=~/.local/share/lionpocket-sync/secrets/auth
KEYCLOAK_ADMIN_PASSWORD_FILE=~/.local/share/lionpocket-sync/secrets/admin
# lpctl automatically runs unprivileged services with your host UID. For direct
# docker compose use LP_UID=<output of id -u>, so chmod-600 secret files are readable.

# Optional with your own proxy/private CA; public PEM root only, never a key.
# HOMELAB_CA_FILE=/absolute/path/to/trusted-public-root-ca.pem
